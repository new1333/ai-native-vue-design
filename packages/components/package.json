  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components.css": "./dist/components.css"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/new1333/ai-native-vue-design.git",
    "directory": "packages/components"
  },
  "bugs": {
    "url": "https://github.com/new1333/ai-native-vue-design/issues"
  },
  "homepage": "https://new1333.github.io/ai-native-vue-design/",
  "keywords": [
    "vue",
    "vue3",
    "components",
    "component-library",
    "design-system",
    "ai-native",
    "typescript",
    "paper"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "build": "vite build"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@ui/tokens": "workspace:*"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/server-renderer": "^3.5.43",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^20.14.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vite-plugin-dts": "^5.1.2",
