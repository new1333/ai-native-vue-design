{
  "name": "@ui/tokens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "纸面 Paper 设计 token 与视觉 Profile（--ui-* CSS 变量；使用方一次性引入 paper.css）",
  "sideEffects": [
    "*.css"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./paper.css": "./src/paper.css"
  },
  "scripts": {
    "typecheck": "vue-tsc --noEmit",
    "build": "vite build",
    "test": "vitest run"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/server-renderer": "^3.5.43",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^20.14.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  }
}
