{
  "name": "@ui/e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "纸面 Paper —— Playwright E2E（playground 真浏览器集成用例；不依赖任何 workspace 包，只打 URL）",
  "scripts": {
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "e2e:update-snapshots": "playwright test --update-snapshots",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.0",
    "@playwright/test": "1.48.2",
    "@types/node": "^22.5.0",
    "typescript": "^5.9.3"
  }
}
